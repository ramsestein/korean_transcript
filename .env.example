# ============================================================================
# REQUIRED FOR VPS DEPLOYMENT
# ============================================================================
# At minimum, you need OPENAI_API_KEY. All other API keys are optional.

# === OpenAI (REQUIRED - minimum for full functionality) ===
OPENAI_API_KEY=sk-...  # REQUIRED: Get from https://platform.openai.com/api-keys
OPENAI_ASR_MODEL=gpt-4o-transcribe

# === Soniox (OPTIONAL - for dual-ASR mode, improves accuracy) ===
SONIOX_API_KEY=       # Optional: Get from https://soniox.com/
SONIOX_MODEL=stt-async-v4

# === Alternative LLM Provider Keys (only if you change providers below) ===
DEEPSEEK_API_KEY=     # Optional: For DeepSeek provider
GEMINI_API_KEY=       # Optional: For Google/Gemini provider
CLAUDE_API_KEY=       # Optional: For Anthropic/Claude provider

# === LLM Task Configuration (default: all OpenAI) ===
# Reconstruction: GPT-5.4-mini for speed/cost balance
LLM_PROVIDER_RECONSTRUCT=openai
LLM_MODEL_RECONSTRUCT=gpt-5.4-mini

# Translation: GPT-5.4-mini for speed/cost balance  
LLM_PROVIDER_TRANSLATE=openai
LLM_MODEL_TRANSLATE=gpt-5.4-mini

# Vision: GPT-5.4-nano for fastest/cheapest image analysis
LLM_PROVIDER_VISION=openai
LLM_MODEL_VISION=gpt-5.4-nano

# Summary: GPT-5.4 (full) for highest quality
LLM_PROVIDER_SUMMARY=openai
LLM_MODEL_SUMMARY=gpt-5.4

# Judge A: GPT-5.4-mini for accurate evaluation
LLM_PROVIDER_JUDGE_A=openai
LLM_MODEL_JUDGE_A=gpt-5.4-mini

# Judge B: GPT-5.4-nano for fast/cheap evaluation
LLM_PROVIDER_JUDGE_B=openai
LLM_MODEL_JUDGE_B=gpt-5.4-nano

# ============================================================================
# OPTIONAL: Pipeline Configuration (defaults are fine for most deployments)
# ============================================================================
DEFAULT_CHUNK_SECONDS=15
DEFAULT_OVERLAP_SECONDS=2
RETROACTIVE_CORRECTION_SEGMENTS=2
CONTEXT_WINDOW_SEGMENTS=6
SESSION_TTL_HOURS=24
DATA_DIR=/app/data        # Keep this for Docker - mounted volume
MAX_IMAGE_MB=10

# === Eval (optional - for prompt optimization features) ===
MAX_PROMPT_REWRITE_ATTEMPTS=3

# ============================================================================
# AUTHENTICATION (OPTIONAL - protects your instance from unauthorized use)
# ============================================================================
# Set to true to require password login
AUTH_ENABLED=true

# Users defined as ENVNAME_USER=password
# Username is derived from the env var name (lowercase, without _USER suffix)
# Examples:
#   USER1_USER=password1  -> creates user "user1"
#   RAMSES_USER=mysecret  -> creates user "ramses"
#   ADMIN_USER=adminpass  -> creates user "admin"
#
# SECURITY NOTES:
# - Tokens expire after 24 hours
# - Max 5 login attempts per 5 minutes per IP (rate limiting)
# - Max 5 active sessions per user
# - Use strong passwords (8+ chars, mixed case, numbers, symbols)

# Auth pepper (optional - adds extra hashing security, change in production)
AUTH_PEPPER=change-this-in-production

# IMPORTANT: Always use HTTPS in production to protect credentials in transit

# ============================================================================
# VPS / PRODUCTION SETTINGS
# ============================================================================

# Ports exposed to the host (change if you have conflicts)
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS: For VPS, set this to your domain or IP
# Example: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# For initial testing with IP: CORS_ORIGINS=http://YOUR_VPS_IP:5173
CORS_ORIGINS=http://localhost:5173

# ============================================================================
# VPS DEPLOYMENT CHECKLIST:
# ============================================================================
# 1. Copy this file to .env and fill in at minimum: OPENAI_API_KEY
# 2. Set CORS_ORIGINS to your VPS IP or domain
# 3. Run: docker compose up -d
# 4. Access frontend at http://YOUR_VPS_IP:5173
# 5. Backend API at http://YOUR_VPS_IP:8000/api/health
# ============================================================================
